{
  "name": "117-terminal",
  "productName": "117Terminal",
  "version": "0.1.3",
  "description": "117Terminal — a block-based terminal with Agent Mode, zsh extensions, MCP and brewcat. By 117-Labs.",
  "main": "out/main/index.js",
  "author": {
    "name": "Everton Araujo",
    "email": "everton.araujo1985@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node --test test/",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty && node scripts/brand-dev.mjs",
    "dist": "electron-vite build && electron-builder && npm run rebuild",
    "dist:mac": "electron-vite build && electron-builder --mac && npm run rebuild",
    "dist:win": "electron-vite build && electron-builder --win && npm run rebuild",
    "dist:linux": "electron-vite build && electron-builder --linux && npm run rebuild"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "dev.117terminal.app",
    "productName": "117Terminal",
    "artifactName": "117Terminal-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "package.json",
      "build/icon.png"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "scripts/after-pack.cjs",
    "afterSign": "scripts/adhoc-sign.cjs",
    "publish": null,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "117Terminal uses the microphone for voice commands. Audio is sent only to the speech engine you choose.",
        "NSAppleEventsUsageDescription": "117Terminal controls Spotify and Apple Music for the built-in player (play, pause, next track) and searches your Apple Music library only when you ask it to.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Folder",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.folder"
            ]
          }
        ]
      }
    },
    "dmg": {
      "title": "117Terminal ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "117Terminal"
    },
    "linux": {
      "icon": "build/icon.png",
      "executableName": "117terminal",
      "category": "System;TerminalEmulator",
      "synopsis": "Block-based terminal with Agent Mode",
      "maintainer": "Everton Araujo <everton.araujo1985@gmail.com>",
      "target": [
        {
          "target": "deb"
        },
        {
          "target": "rpm"
        },
        {
          "target": "tar.gz"
        }
      ],
      "mimeTypes": [
        "inode/directory"
      ],
      "desktop": {
        "entry": {
          "Keywords": "terminal;shell;prompt;command;agent;ai;",
          "StartupNotify": "true",
          "Actions": "new-tab;settings;web;"
        },
        "desktopActions": {
          "new-tab": {
            "Name": "New Tab",
            "Exec": "/opt/117Terminal/117terminal --new-tab"
          },
          "settings": {
            "Name": "Settings",
            "Exec": "/opt/117Terminal/117terminal --settings"
          },
          "web": {
            "Name": "Open in Browser (Web Mode)",
            "Exec": "/opt/117Terminal/117terminal --serve --open"
          }
        }
      }
    },
    "deb": {
      "depends": [
        "libnss3",
        "libgtk-3-0t64 | libgtk-3-0",
        "libgbm1",
        "libasound2t64 | libasound2",
        "xdg-utils"
      ]
    },
    "rpm": {
      "depends": [
        "nss",
        "gtk3",
        "mesa-libgbm",
        "alsa-lib",
        "xdg-utils"
      ]
    }
  },
  "homepage": "https://github.com/1985epma/117-terminal",
  "repository": {
    "type": "git",
    "url": "https://github.com/1985epma/117-terminal.git"
  },
  "desktopName": "117terminal.desktop"
}

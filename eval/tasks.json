    {
      "id": "public-ip-en",
      "prompt": "what's my public IP address?",
      "expect": {
        "tool": "run_command",
        "commandMatches": ["curl.*(ifconfig|ipinfo|icanhazip|ipify|ident\\.me|checkip)", "dig\\b.*(myip|whoami)"],

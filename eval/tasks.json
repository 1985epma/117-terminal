      }
    },
    {
      "id": "no-interactive-editor-en",
      "prompt": "open my .zshrc in vim",
      "context": { "cwd": "/Users/dev" },
      "expect": {
        "commandNotMatches": ["\\bvim?\\b", "\\bnano\\b", "\\bless\\b", "\\bemacs\\b"]
      }
    },
    {
      "id": "last-commits-pt",
      "prompt": "quais foram os últimos 5 commits?",
